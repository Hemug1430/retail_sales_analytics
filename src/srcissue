import csv
import mysql.connector
from datetime import datetime
from pathlib import Path

# Setup absolute paths to avoid resolution issues
BASE_DIR = Path(__file__).resolve().parent.parent
csv_path = BASE_DIR / "data" / "synthetic" / "stores_master.csv"

print("Connecting to database...")
try:
    conn = mysql.connector.connect(
        host="localhost",
        user="root",
        password="Root",
        database="retail_sales_db"
    )
    cursor = conn.cursor()
    print("Database connection: SUCCESS")
    
    # 1. Truncate old staging records to avoid duplicates
    print("Truncating old staging records...")
    cursor.execute("TRUNCATE TABLE stg_stores;")
    conn.commit()
    
    # 2. Define standard staging insert query
    insert_sql = """
        INSERT INTO stg_stores (
            store_id, store_name, store_type, city, state, region, 
            postal_code, opening_date, floor_area_sqft, manager_name, 
            status, batch_id, source_file_name, source_row_number, 
            record_hash, load_timestamp
        ) VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
    """

    print("Reading CSV and loading rows...")
    with open(csv_path, mode="r", encoding="utf-8") as f:
        reader = csv.DictReader(f)
        for idx, row in enumerate(reader, start=1):
            
            # Fix zero-padding mismatch: Convert 'STORE00001' -> 'STORE001'
            original_id = row['store_id']
            clean_store_id = original_id.replace("STORE000", "STORE0")
            
            # Match the format used in core_stores
            row_hash = clean_store_id
            
            params = (
                clean_store_id, row['store_name'], row['store_type'], row['city'], row['state'], row['region'],
                str(row['postal_code']), row['opening_date'], int(row['floor_area_sqft']), row['manager_name'],
                row['status'], "BATCH_001", "stores_master.csv", idx, row_hash, datetime.now()
            )
            cursor.execute(insert_sql, params)
            
    conn.commit()
    print(f"Pipeline unblocked! Loaded clean records into stg_stores.")

except Exception as e:
    print(f"Execution Error: {e}")
finally:
    if 'cursor' in locals(): cursor.close()
    if 'conn' in locals(): conn.close()
